# The crates.io token used to publish the Fragment Rust crates.
#
# Copy this file to `.env` and fill in your token. The `.env` file is
# ignored by git, so it is never committed.
#
#   cp .env.example .env
#
# Create a token at https://crates.io/settings/tokens. It needs the
# `publish-new-crate` scope the first time, and `publish` after that.
#
# The same token can be named CARGO_REGISTRY_TOKEN in the repository
# secrets, which is what the release workflow uses.

CARGO_REGISTRY_TOKEN=crates-io-token-goes-here
