use proc_macro::TokenStream;
use quote::quote;
use syn::{parse_macro_input, ItemFn, ItemImpl, ItemStruct, LitStr};

struct RouteArgs {
    method: syn::Ident,
    __sep: syn::Token![,],
    path: LitStr,
}

impl syn::parse::Parse for RouteArgs {
    fn parse(input: syn::parse::ParseStream) -> syn::Result<Self> {
        Ok(RouteArgs {
            method: input.parse()?,
            __sep: input.parse()?,
            path: input.parse()?,
        })
    }
}

struct ControllerArgs {
    prefix: LitStr,
}

impl syn::parse::Parse for ControllerArgs {
    fn parse(input: syn::parse::ParseStream) -> syn::Result<Self> {
        Ok(Self {
            prefix: input.parse()?,
        })
    }
}

struct ApplicationArgs {
    port: Option<syn::LitInt>,
    host: Option<syn::LitStr>,
    auto_scan: Option<syn::LitBool>,
}

impl syn::parse::Parse for ApplicationArgs {
    fn parse(input: syn::parse::ParseStream) -> syn::Result<Self> {
        let mut port = None;
        let mut host = None;
        let mut auto_scan = None;

        while !input.is_empty() {
            let ident = input.parse::<syn::Ident>()?;
            let _eq = input.parse::<syn::Token![=]>()?;

            match ident.to_string().as_str() {
                "port" => port = Some(input.parse()?),
                "host" => host = Some(input.parse()?),
                "auto_scan" => auto_scan = Some(input.parse()?),
                _ => return Err(syn::Error::new(ident.span(), "unknown option")),
            }

            if input.peek(syn::Token![,]) {
                let _ = input.parse::<syn::Token![,]>()?;
            }
        }

        Ok(Self { port, host, auto_scan })
    }
}

#[proc_macro_attribute]
    use syn::parse::Parse;
    
    let input = parse_macro_input!(item as ItemStruct);
    let name = &input.ident;

    // Collect existing derives to preserve them
                    match &item {
                        syn::NestedMeta::Meta(syn::Meta::Path(path)) => preserves_derives.push(path.clone()),
                        _ => {},
                    }
    let mut preserves_derives = Vec::new();
    for attr in &input.attrs {
        if attr.path().is_ident("derive") {
            if let syn::Meta::List(list) = &attr.meta {
                for item in list.tokens.clone().into_iter() {
                    if let syn::NestedMeta::Meta(syn::Meta::Path(path)) = item {
                        preserves_derives.push(path);
                    }
                }
            }
        }
    }

    // Add Clone derive to the list
    preserves_derives.push(parse_quote!(Clone));

    let expanded = quote! {
        #[derive(Clone)]
        #input

        ::fragment_rs::core::container::register_service(|| {
            ::fragment_rs::core::container::DIContainer::register(#name::new());
        });

        impl ::fragment_rs::core::container::Injectable for #name {
            fn scope() -> ::fragment_rs::core::container::Scope {
                ::fragment_rs::core::container::Scope::Singleton
            }
        }

        impl ::fragment_rs::core::container::Service for #name {}
    };

    TokenStream::from(expanded)
}

#[proc_macro_attribute]
    use syn::parse::Parse;
    
    let input = parse_macro_input!(item as ItemStruct);
    let name = &input.ident;

    // Collect existing derives to preserve them
                    match &item {
                        syn::NestedMeta::Meta(syn::Meta::Path(path)) => preserves_derives.push(path.clone()),
                        _ => {},
                    }
    let mut preserves_derives = Vec::new();
    for attr in &input.attrs {
        if attr.path().is_ident("derive") {
            if let syn::Meta::List(list) = &attr.meta {
                for item in list.tokens.clone().into_iter() {
                    if let syn::NestedMeta::Meta(syn::Meta::Path(path)) = item {
                        preserves_derives.push(path);
                    }
                }
            }
        }
    }

    // Add Clone derive to the list
    preserves_derives.push(parse_quote!(Clone));

    let expanded = quote! {
        #[derive(Clone)]
        #input

        ::fragment_rs::core::container::register_service(|| {
            ::fragment_rs::core::container::DIContainer::register(#name::default());
        });

        impl ::fragment_rs::core::container::Service for #name {}
    };

    TokenStream::from(expanded)
}

#[proc_macro_attribute]
pub fn exception_filter(_attr: TokenStream, item: TokenStream) -> TokenStream {
    let input = parse_macro_input!(item as ItemStruct);
    let name = &input.ident;

    let expanded = quote! {
        #[derive(Clone)]
        #input

        ::fragment_rs::core::container::register_service(|| {
            ::fragment_rs::core::container::DIContainer::register(#name::default());
        });

        impl ::fragment_rs::core::filter::ExceptionFilter for #name {}
        impl ::fragment_rs::core::container::Service for #name {}
    };

    TokenStream::from(expanded)
}

#[proc_macro_attribute]
    use syn::parse::Parse;
    
    let args = parse_macro_input!(attr as ControllerArgs);
    let prefix_str = args.prefix.value();
    let mut impl_block = parse_macro_input!(item as ItemImpl);
    let self_ty = &impl_block.self_ty;

    // Collect existing derives to preserve them
                    match &item {
                        syn::NestedMeta::Meta(syn::Meta::Path(path)) => preserves_derives.push(path.clone()),
                        _ => {},
                    }
    let mut preserves_derives = Vec::new();
    for attr in &self_ty.attrs {
        if attr.path().is_ident("derive") {
            if let syn::Meta::List(list) = &attr.meta {
                for item in list.tokens.clone().into_iter() {
                    if let syn::NestedMeta::Meta(syn::Meta::Path(path)) = item {
                        preserves_derives.push(path);
                    }
                }
            }
        }
    }

    // Add FragmentRoute derive to the list
    preserves_derives.push(parse_quote!(FragmentRoute));

    let prefix = prefix_str.trim_end_matches('/');
    let mut routes: Vec<proc_macro2::TokenStream> = Vec::new();

    for item in &mut impl_block.items {
        if let syn::ImplItem::Fn(method) = item {
            let mut route_attrs: Vec<RouteArgs> = Vec::new();
            let mut other_attrs = Vec::new();

            for attr in std::mem::take(&mut method.attrs) {
                if attr.path().is_ident("route") {
                    if let Ok(args) = attr.parse_args::<RouteArgs>() {
                        route_attrs.push(args);
                    }
                } else {
                    other_attrs.push(attr);
                }
            }
            method.attrs = other_attrs;

            for RouteArgs { method: http_method, path: path_lit, .. } in route_attrs {
                let path_val = path_lit.value();
                let r = path_val.trim_start_matches('/');
                let full_path = if prefix.is_empty() {
                    format!("/{}", r)
                } else {
                    format!("{}/{}", prefix, r)
                };

                let method_fn = match http_method.to_string().as_str() {
                    "GET" => quote! { axum::routing::get(#self_ty::#http_method as _) },
                    "POST" => quote! { axum::routing::post(#self_ty::#http_method as _) },
                    "PUT" => quote! { axum::routing::put(#self_ty::#http_method as _) },
                    "DELETE" => quote! { axum::routing::delete(#self_ty::#http_method as _) },
                    "PATCH" => quote! { axum::routing::patch(#self_ty::#http_method as _) },
                    m => panic!("Unsupported HTTP method: {}", m),
                };

                routes.push(quote! {
                    router = router.route(#full_path, #method_fn);
                });
            }
        }
    }

    let expanded = quote! {
        #impl_block

        impl ::fragment_rs::core::routing::FragmentRoute for #self_ty {
            fn register_routes(&self, mut router: axum::Router) -> axum::Router {
                #(#routes)*
                router
            }
        }

        ::fragment_rs::core::container::register_controller(|| Arc::new(#self_ty) as Arc<dyn ::fragment_rs::core::routing::FragmentRoute>);
    };

    TokenStream::from(expanded)
}

#[proc_macro_attribute]
pub fn route(attr: TokenStream, item: TokenStream) -> TokenStream {
    let args = parse_macro_input!(attr as RouteArgs);
    let method_str = args.method.to_string();
    let path_str = args.path.value();

    let mut fn_item = parse_macro_input!(item as ItemFn);
    fn_item.attrs.push(syn::parse_quote!(#[fragment_route(#method_str, #path_str)]));
    TokenStream::from(quote!(#fn_item))
}

#[proc_macro_attribute]
pub fn fragment_application(attr: TokenStream, item: TokenStream) -> TokenStream {
    let args = parse_macro_input!(attr as ApplicationArgs);
    let input = parse_macro_input!(item as ItemStruct);

    let port = args.port.map(|p| p.base10_parse::<u16>().unwrap_or(3000)).unwrap_or(3000);
    let host = args.host.as_ref().map(|h| h.value()).unwrap_or_else(|| "0.0.0.0".into());
    let auto_scan = args.auto_scan.map(|a| a.value()).unwrap_or(true);

    let expanded = quote! {
        #input

        impl ::fragment_rs::platform::web::FragmentApp {
            pub fn app_config() -> ::fragment_rs::platform::web::FragmentApp {
                ::fragment_rs::platform::web::FragmentApp::new()
                    .port(#port)
                    .host(&#host)
                    .auto_scan(#auto_scan)
            }
        }
    };

    TokenStream::from(expanded)
}

#[proc_macro_derive(FragmentPrivacy, attributes(pii))]
pub fn derive_fragment_privacy(input: TokenStream) -> TokenStream {
    let input = parse_macro_input!(input as syn::DeriveInput);
    let name = &input.ident;

    let expanded = quote! {
        impl ::fragment_rs::core::privacy::Privacy for #name {
            fn masked(&self) -> serde_json::Value {
                serde_json::to_value(self).unwrap_or_default()
            }
        }
    };

    TokenStream::from(expanded)
}
